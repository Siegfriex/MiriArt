# MiriArt 환경변수 템플릿
# .env.local로 복사 후 실제 값을 입력하세요
# cp .env.example .env.local

# Gemini API Key
GEMINI_API_KEY=

# Cloud Run 서버 URL
# 로컬 개발: http://localhost:8080
# GCP 배포 후: https://<service-name>-<hash>-<region>.run.app
VITE_API_BASE_URL=http://localhost:8080

# 개발 시 로그인 우회 (npm run dev 시 기본 활성화)
# 로그인/온보딩 플로우 테스트 시: VITE_DEV_SKIP_AUTH=false
# VITE_DEV_SKIP_AUTH=false
